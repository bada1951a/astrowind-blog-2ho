---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 2호기 대문 이미지 불러오기
import moonImg from '~/assets/images/moon.jpg';

const metadata = {
  title: 'Story Daily Tech — Practical Life & Tech Insights',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Articles',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
    image={{
      src: moonImg.src,
      alt: 'Story Daily Tech - Troubleshooting Guides & Solutions',
    }}
  >
    <Fragment slot="title">
      Practical Life & Tech Insights,<br />
      <span class="text-accent dark:text-white highlight">Story Daily Tech</span>
    </Fragment>

    <Fragment slot="subtitle">
      Practical troubleshooting guides, mobile diagnostics, and actionable digital workflows for everyday tech.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Articles"
    information="Explore verified troubleshooting workflows and practical tech guides."
    count={8}
  />
</Layout>
